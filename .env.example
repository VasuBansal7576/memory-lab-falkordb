FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6387
MEMORY_NAMESPACE=graph_memory_lab_v2
APP_PORT=8791
# Optional. Keep actual secrets in your shell or an untracked .env file.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional: model used by the locally authenticated Codex CLI.
MEMORY_CODEX_MODEL=gpt-6.1-sol

# Local passage embeddings (384 dimensions); disable for keyword-only operation.
MEMORY_SEMANTIC=1
# Optional paths default to .memory and .memory/notes under this project.
# MEMORY_STATE_DIR=/absolute/path/to/private/state
# MEMORY_NOTES_DIR=/absolute/path/to/markdown/notes
# headless: process on session close; next_session: defer to SessionStart; off: no capture.
MEMORY_CAPTURE_MODE=headless
MEMORY_MIN_TURNS=2
MEMORY_AUTO_EXTRACT=1

# Reference workflow controls.
MEMORY_RECALL_MODE=hybrid
MEMORY_CONTEXT_CHARS=6000
MEMORY_NOTE_CONTEXT_CHARS=1500
MEMORY_NOTE_HIT_CHARS=280
MEMORY_NEIGHBOR_LINES=6
MEMORY_MAX_TURNS=30
MEMORY_MAX_CHARS=15000
MEMORY_PROCESS_LIMIT=20
MEMORY_DISTIL=1
# MEMORY_LOG_DIR=daily
# MEMORY_DIGEST_PROMPT=/absolute/path/to/digest-voice.txt
MEMORY_WRITE_PROVIDER=codex
# MEMORY_WRITE_MODEL=
# MEMORY_DIGEST_MODEL=
MEMORY_CLAUDE_MODEL=sonnet
# Optional filtering of native cosine-distance results (unset takes nearest ten).
# MEMORY_VECTOR_MAX_DISTANCE=0.45
